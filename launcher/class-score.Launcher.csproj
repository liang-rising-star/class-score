<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>class-score</AssemblyName>
    <RootNamespace>ClassScore.Launcher</RootNamespace>
    <ApplicationIcon>..\logo.ico</ApplicationIcon>
    <AssemblyTitle>class-score</AssemblyTitle>
    <Product>class-score</Product>
    <Company>liang-rising-star</Company>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <DebugType>none</DebugType>

    <!-- 原生 AOT：编译成单个原生 exe，不依赖 .NET 运行时，也不需要在根目录放一堆 DLL -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
